From 2bebf301ff9cfa7394d203844edfc5936eb53d85 Mon Sep 17 00:00:00 2001
From: Ricardo Branco <rbranco@suse.de>
Date: Mon, 5 Oct 2026 16:00:29 +0200
Subject: [PATCH] tests: normalize platform in TestBuildAnnotations descriptor
 key

On arm64, platforms.DefaultSpec() returns linux/arm64/v8, while the
worker reports linux/arm64. The manifest-descriptor annotation key
therefore matched no platform and the annotation was silently dropped,
causing the example4 assertion to fail. The image lookup in the same
test already uses platforms.Normalize; do the same for the annotation
key.

Signed-off-by: Ricardo Branco <rbranco@suse.de>
---
 tests/build.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/build.go b/tests/build.go
index e7d6b8a9b523..39a3790edb77 100644
--- a/tests/build.go
+++ b/tests/build.go
@@ -921,7 +921,7 @@ func testBuildAnnotations(t *testing.T, sb integration.Sandbox) {
 		"--annotation", "example1=www",
 		"--annotation", "index:example2=xxx",
 		"--annotation", "manifest:example3=yyy",
-		"--annotation", "manifest-descriptor[" + platforms.Format(platforms.DefaultSpec()) + "]:example4=zzz",
+		"--annotation", "manifest-descriptor[" + platforms.Format(platforms.Normalize(platforms.DefaultSpec())) + "]:example4=zzz",
 	}
 	out, err := buildCmd(sb, withArgs(annotations...), withArgs(fmt.Sprintf("--output=type=image,name=%s,push=true", target), dir))
 	require.NoError(t, err, string(out))
