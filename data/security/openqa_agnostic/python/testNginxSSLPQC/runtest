#!/bin/bash
# METADATA_START
# ---
# test: nginx web server SSL post-quantum cryptography test using ML-DSA signature and ML-KEM key exchange algorithms
# desc: Verifies that ML-DSA & ML-KEM post-quantum algorithms work through the nginx web server
# steps:
# - 1. Setup nginx
#   - set up an nginx SSL virtual host that enforces TLS v1.3 and the 3 ML-KEM key exchange algorithms
#     (see provided pqc-ssl.conf)
#   - write a test page to the nginx document root
# - 2. For each of MLDSA44, MLDSA65 and MLDSA87:
#   - generate the ML-DSA key + certificate pair (self signed) and deploy it to nginx
#   - restart nginx and check that it's listening
#   - use openssl s_client to verify that we can establish a TLS v1.3 connection using the 3 ML-KEM algorithms
#     (MLKEM512, MLKEM768 and MLKEM1024)
#   - verify peer signature is the expected ML-DSA variant
#   - fetch the test page with curl through TLS v1.3 connection, using the 3 ML-KEM algorithms
#
# Remark: SLH_DSA_* post-quantum signature algorithms do not work with TLS v1.3 because none of the SLH-DSA
#         variants are registered as TLS-SIGALGS (can be checked using openssl list -tls-signature-algorithms).
#         Hence SLH_DSA_* algorithms cannot be tested at this time.
#         See OpenSSL feature request: https://github.com/openssl/openssl/issues/28026
#
# author: <pstivanin@suse.com>
# maintainer: QE Security <none@suse.de>
# expected: no errors raised, connection succeed
# platform: SLE16
# tags: security post-quantum-crypto ssl nginx python poo#209418
# ---
# METADATA_END

set -e

# Source the helper script for argument handling
source ../lib/helper.sh

# Define files required for this test
TEST_FILES=(nginx_pqc_ssl_test.py pqc-ssl.conf)

# Delegate argument processing to the helper
handle_args "$0" "$@"

# If the metadata flag is not provided, run the tests as usual.

# run tests with pytest and generate junit xml results
pytest -v nginx_pqc_ssl_test.py --junitxml=results.xml
